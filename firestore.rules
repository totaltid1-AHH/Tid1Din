rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // 1. BEDRIFTER (COMPANIES) OG UNDERLIGGENDE SUB-COLLECTIONS
    // Fullstendig organisert og isolert under hvert enkelt firma
    // ===============================================================
    match /companies/{companyId} {
      allow read, write: if true;

      // Sub-collections under hver bedrift (Tenant-isolert)
      match /appointments/{appointmentId} {
        allow read, write: if true;
      }

      match /journals/{journalId} {
        allow read, write: if true;
      }

      match /workingHours/{docId} {
        allow read, write: if true;
      }

      match /holidays/{holidayId} {
        allow read, write: if true;
      }

      match /smsSettings/{docId} {
        allow read, write: if true;
      }

      match /smsTemplates/{templateId} {
        allow read, write: if true;
      }

      match /smsLogs/{logId} {
        allow read, create: if true;
        allow update, delete: if false; // Uforanderlig logg
      }

      match /systemLogs/{logId} {
        allow read, create: if true;
        allow update, delete: if false; // Uforanderlig revisjonslogg
      }
    }

    // ===============================================================
    // 2. STØTTE FOR COLLECTION-GROUP OG MIGRERING
    // Tillater superadmin spørringer på tvers av bedrifter
    // ===============================================================
    match /{path=**}/appointments/{appointmentId} {
      allow read, write: if true;
    }

    match /{path=**}/journals/{journalId} {
      allow read, write: if true;
    }

    match /{path=**}/workingHours/{docId} {
      allow read, write: if true;
    }

    match /{path=**}/holidays/{holidayId} {
      allow read, write: if true;
    }

    match /{path=**}/smsSettings/{docId} {
      allow read, write: if true;
    }

    match /{path=**}/smsTemplates/{templateId} {
      allow read, write: if true;
    }

    match /{path=**}/smsLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /{path=**}/systemLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // ===============================================================
    // 3. BRUKERPROFILER (USERS) - GLOBAL AUTENTISERING & ROLLESTYRING
    // ===============================================================
    match /users/{userId} {
      allow read, write: if true;
    }

    // ===============================================================
    // 4. GLOBAL SYSTEMKONFIGURASJON (SUPERADMIN)
    // ===============================================================
    match /systemConfig/{configId} {
      allow read, write: if true;
    }

    // ===============================================================
    // 5. SERVER-ONLY PASSORD-TILBAKESTILLINGER (CLOUD FUNCTIONS)
    // ===============================================================
    match /passwordResets/{resetId} {
      allow read, write: if false; // Kun Firebase Admin SDK
    }

    // ===============================================================
    // STANDARD: AVVIS ALL ANNEN TILGANG (DEFAULT DENY)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
